<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <main class="calculadora">
        <h1>Calculadora</h1>

        <div class="form-group">
            <label for="primerNumero">Ingresar el primer número</label>
            <input type="number" id="primerNumero" placeholder="Ej. 5">
        </div>

        <div class="form-group">
            <label for="operacion">Tipo de operación</label>
            <select id="operacion">
                <option value="sumar">Sumar</option>
                <option value="restar">Restar</option>
                <option value="multiplicar">Multiplicar</option>
                <option value="dividir">Dividir</option>
            </select>
        </div>

        <div class="form-group">
            <label for="segundoNumero">Ingresar el segundo número</label>
            <input type="number" id="segundoNumero" placeholder="Ej. 3">
        </div>

        <div class="button-group">
            <button id="btnCalcular">Calcular</button>
        </div>

        <div class="resultado" id="resultado">
            <p>El resultado es: <span id="valorResultado">0</span></p>
        </div>

        <section class="historial">
            <h2>Operaciones anteriores</h2>
            <ul id="listaOperaciones"></ul>
        </section>
    </main>

    <script>
        const primerNumeroInput = document.getElementById('primerNumero');
        const segundoNumeroInput = document.getElementById('segundoNumero');
        const operacionSelect = document.getElementById('operacion');
        const btnCalcular = document.getElementById('btnCalcular');
        const valorResultado = document.getElementById('valorResultado');
        const listaOperaciones = document.getElementById('listaOperaciones');

        const historial = [];

        function calcular() {
            const primerNumero = parseFloat(primerNumeroInput.value);
            const segundoNumero = parseFloat(segundoNumeroInput.value);
            const operacion = operacionSelect.value;

            if (isNaN(primerNumero) || isNaN(segundoNumero)) {
                alert('Por favor, ingresa los dos números.');
                return;
            }

            let resultado;
            let simbolo;

            switch (operacion) {
                case 'sumar':
                    resultado = primerNumero + segundoNumero;
                    simbolo = '+';
                    break;
                case 'restar':
                    resultado = primerNumero - segundoNumero;
                    simbolo = '-';
                    break;
                case 'multiplicar':
                    resultado = primerNumero * segundoNumero;
                    simbolo = '×';
                    break;
                case 'dividir':
                    if (segundoNumero === 0) {
                        alert('No se puede dividir entre cero.');
                        return;
                    }
                    resultado = primerNumero / segundoNumero;
                    simbolo = '÷';
                    break;
                default:
                    return;
            }

            valorResultado.textContent = resultado;

            const registro = `${primerNumero} ${simbolo} ${segundoNumero} = ${resultado}`;
            historial.unshift(registro);
            actualizarHistorial();
        }

        function actualizarHistorial() {
            listaOperaciones.innerHTML = '';

            historial.forEach((operacion) => {
                const elemento = document.createElement('li');
                elemento.textContent = operacion;
                listaOperaciones.appendChild(elemento);
            });
        }

        btnCalcular.addEventListener('click', calcular);
    </script>
</body>
</html>
